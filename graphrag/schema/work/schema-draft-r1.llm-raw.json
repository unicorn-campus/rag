  "node_types": [
    {
      "label": "Invention",
      "description": "특허법이 보호하는 발명 자체. 조문에 나타나는 명사구(예: “새로운 화학물질”, “전기 회로”)를 그대로 name에 넣는다. 조사·괄호·조문 번호는 제외한다.",
      "properties": [
        {
          "name": "name",
          "type": "STRING",
          "description": "조문에 명시된 발명 명칭(명사구)",
          "required": true
        }
      ]
    },
    {
      "label": "PatentRight",
